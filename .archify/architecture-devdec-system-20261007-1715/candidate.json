  "cards": [
    {
      "dot": "cyan",
      "title": "Two lanes, one machinery",
      "items": [
        "sys1 lane judges what the work says: diffs, plans, logs, docs",
        "sdm1 lane scores what the work measures: run histories, benchmarks, calibration stores",
        "Same JSONL rows, dispositions, and per-head floors for both"
      ]
    },
    {
      "dot": "emerald",
      "title": "Batch-only rule",
      "items": [
        "Tabular model calls are minutes-scale \u2014 never inside a synchronous hook path",
        "Pre-push reads the cached risk table: a local CSV, zero network"
      ]
    },
    {
      "dot": "rose",
      "title": "Earned autonomy",
      "items": [
        "Advisorial by default; override rates decide when a gate may block",
        "sdm1 component routing is eval-only: logged, never applied as labels",
        "Declines are first-class answers \u2014 the tabular text-lane bridge declines without labeled context"
      ]
    }
  ]
